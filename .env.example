# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, add it in Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform interactive map visualization.
# Exposed to the client bundle at build time on Vercel as well.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# GTEC_SESSION_SECRET: HMAC secret used to sign authentication tokens.
# Required in production (set it on Vercel) so tokens cannot be forged.
GTEC_SESSION_SECRET="CHANGE_ME_LONG_RANDOM_STRING"

# GTEC_DB_PATH: Optional override for the JSON database file location.
# On Vercel the database is stored in /tmp (ephemeral per instance).
# Point it to a persistent volume path when deploying on a long-running host.
# GTEC_DB_PATH="/data/gtec-database.json"
